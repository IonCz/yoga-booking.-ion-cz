{{> head}}
{{> header}}

<main class="container py-4">

  <!-- HERO -->
  <section class="text-center mb-5">
    <h1 class="page-title mb-3">Yoga & Mindfulness Studio</h1>
    <p class="muted">
      Find balance, improve flexibility, and enhance your well-being through guided yoga and mindfulness sessions.
    </p>
  </section>

  <!-- ABOUT -->
  <section class="card section-card p-4 mb-4">
    <h2 class="h5 mb-3">About Us</h2>
    <p class="mb-0">
      Our studio offers a range of yoga and mindfulness classes designed for all levels,
      from beginners to advanced practitioners. Our goal is to promote well-being,
      flexibility, and mental clarity.
    </p>
  </section>

  <!-- COURSES -->
  <section class="card section-card p-4 mb-4">
    <h2 class="h5 mb-3">Our Courses</h2>
    <p class="mb-0">
      We offer both weekly courses and weekend workshops. Each course includes multiple
      sessions guided by experienced instructors.
    </p>
  </section>

  <!-- LOCATIONS -->
  <section class="card section-card p-4 mb-4">
    <h2 class="h5 mb-3">Locations</h2>
    <p class="mb-2">
      Classes take place in different studio rooms, including:
    </p>

    <ul class="mb-0">
      <li>Main Yoga Hall</li>
      <li>Upstairs Studio</li>
      <li>Mindfulness Room A</li>
      <li>Studio B</li>
    </ul>
  </section>

  <!-- PRICING -->
  <section class="card section-card p-4">
    <h2 class="h5 mb-3">Pricing</h2>
    <p class="mb-0">
      Course prices vary depending on duration and level. You can view detailed pricing
      on each course page before booking.
    </p>
  </section>

</main>

{{> footer}}