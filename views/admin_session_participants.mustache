{{> head}}
{{> header}}

<main class="container py-4">

  <section class="mb-4">
    <h1 class="page-title mb-2">Session Participants</h1>
    <p class="muted mb-0">
      View the participants booked for this session.
    </p>
  </section>

  <section class="card section-card p-4 mb-4">
    <div class="row g-3">
      <div class="col-12 col-md-6">
        <p class="mb-1"><strong>Start:</strong></p>
        <p class="muted mb-0">{{session.startDateTime}}</p>
      </div>

      <div class="col-12 col-md-6">
        <p class="mb-1"><strong>End:</strong></p>
        <p class="muted mb-0">{{session.endDateTime}}</p>
      </div>

      <div class="col-12 col-md-6">
        <p class="mb-1"><strong>Capacity:</strong></p>
        <p class="muted mb-0">{{session.capacity}}</p>
      </div>

      <div class="col-12 col-md-6">
        <p class="mb-1"><strong>Booked Count:</strong></p>
        <p class="muted mb-0">{{session.bookedCount}}</p>
      </div>
    </div>

    <div class="mt-4">
      <a class="btn custom-btn-secondary" href="/courses/{{session.courseId}}">
        ← Back to Course
      </a>
    </div>
  </section>

  <section class="card section-card p-3">
    {{#hasParticipants}}
    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead>
          <tr>
            <th>Name</th>
            <th>Email</th>
          </tr>
        </thead>
        <tbody>
          {{#participants}}
          <tr>
            <td><strong>{{name}}</strong></td>
            <td class="muted">{{email}}</td>
          </tr>
          {{/participants}}
        </tbody>
      </table>
    </div>
    {{/hasParticipants}}

    {{^hasParticipants}}
    <div class="text-center p-3">
      <h3 class="h5 mb-2">No participants yet</h3>
      <p class="muted mb-0">
        No participants for this session yet.
      </p>
    </div>
    {{/hasParticipants}}
  </section>

</main>

{{> footer}}