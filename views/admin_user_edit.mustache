{{> head}}
{{> header}}

<main class="container py-4">

  <section class="mb-4">
    <h1 class="page-title mb-2">Edit User</h1>
    <p class="muted mb-0">
      Update the selected user account details.
    </p>
  </section>

  {{#error}}
  <div class="message-error mb-4">
    {{error}}
  </div>
  {{/error}}

  <section class="card section-card p-4">
    <form method="POST" action="/admin/users/{{userData.id}}/edit" class="row g-3">

      <div class="col-12 col-md-6">
        <label for="name" class="form-label">Name</label>
        <input
          id="name"
          name="name"
          type="text"
          class="form-control"
          value="{{userData.name}}"
          required
        />
      </div>

      <div class="col-12 col-md-6">
        <label for="email" class="form-label">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          class="form-control"
          value="{{userData.email}}"
          required
        />
      </div>

      <div class="col-12 col-md-6">
        <label for="password" class="form-label">New Password</label>
        <input
          id="password"
          name="password"
          type="password"
          class="form-control"
          placeholder="Leave blank to keep current password"
        />
        <small class="muted">
          Only enter a new password if you want to change it.
        </small>
      </div>

      <div class="col-12 col-md-6">
        <label for="role" class="form-label">Role</label>
        <select id="role" name="role" class="form-select">
          <option value="student" {{#userData.isStudent}}selected{{/userData.isStudent}}>Student</option>
          <option value="instructor" {{#userData.isInstructor}}selected{{/userData.isInstructor}}>Instructor</option>
        </select>
      </div>

      <div class="col-12">
        <button type="submit" class="btn custom-btn-primary">
          Save Changes
        </button>
      </div>

    </form>
  </section>

</main>

{{> footer}}