{{> head}}
{{> header}}

<main class="container py-4">
  <section class="text-center mb-4">
    <h1 class="page-title mb-2">Upcoming Courses</h1>
    <p class="text-muted">
      Discover our latest yoga and mindfulness courses for all levels.
    </p>
  </section>

  <div class="row g-4">
    {{#courses}}
    <div class="col-12 col-md-6 col-xl-4">
      <article class="card h-100 border-0 section-card">
        <div class="card-body d-flex flex-column">
          <h2 class="h4 mb-3">{{title}}</h2>

          <p class="muted mb-3">
            <strong>Level:</strong> {{level}}
            <span class="mx-1">•</span>
            <strong>Type:</strong> {{type}}
            {{#allowDropIn}}
            <span class="mx-1">•</span>
            <span>Drop-in OK</span>
            {{/allowDropIn}}
          </p>

          <p class="mb-3">{{description}}</p>

          <div class="mb-3">
            <p class="muted mb-2">
              <strong>Dates:</strong> {{startDate}} – {{endDate}}
            </p>
            <p class="muted mb-2">
              <strong>Next session:</strong> {{nextSession}}
            </p>
            <p class="muted mb-2">
              <strong>Sessions:</strong> {{sessionsCount}}
            </p>
            <p class="muted mb-0">
              <strong>Price:</strong> £{{price}}
            </p>
          </div>

          <div class="mt-auto pt-2">
            <a class="btn custom-btn-primary w-100" href="/courses/{{id}}">
              View &amp; Book
            </a>
          </div>
        </div>
      </article>
    </div>
    {{/courses}}

    {{^courses}}
    <div class="col-12">
      <div class="card section-card text-center">
        <div class="card-body">
          <h2 class="h5 mb-2">No courses available yet</h2>
          <p class="muted mb-0">
            Please check back later for upcoming classes and workshops.
          </p>
        </div>
      </div>
    </div>
    {{/courses}}
  </div>
</main>

{{> footer}}
