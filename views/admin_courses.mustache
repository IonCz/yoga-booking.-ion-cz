{{> head}}
{{> header}}

<main class="container py-4">

  <!-- TITLE -->
  <section class="mb-4">
    <h1 class="page-title mb-2">Manage Courses</h1>
    <p class="muted mb-0">
      View, edit and manage all existing courses.
    </p>
  </section>

  <!-- SUCCESS MESSAGE -->
  {{#successMessage}}
  <div class="message-success mb-4">
    {{successMessage}}
  </div>
  {{/successMessage}}

  <!-- COURSES GRID -->
  <div class="row g-4">

    {{#courses}}
    <div class="col-12 col-md-6 col-xl-4">
      <article class="card section-card h-100 p-3 d-flex flex-column">

        <h2 class="h5 mb-2">{{title}}</h2>

        <p class="muted mb-2">
          <strong>{{level}}</strong> • {{type}}
        </p>

        <p class="muted mb-3">
          {{startDate}} – {{endDate}}
        </p>

        <!-- ACTION BUTTONS -->
        <div class="d-flex flex-wrap gap-2 mt-auto">

          <a class="btn custom-btn-secondary btn-sm"
             href="/courses/{{id}}">
            View
          </a>

          <a class="btn custom-btn-primary btn-sm"
             href="/admin/courses/{{id}}/edit">
            Edit
          </a>

          <a class="btn custom-btn-secondary btn-sm"
             href="/admin/courses/{{id}}/participants">
            Participants
          </a>

        </div>

        <!-- DELETE -->
        <form
          method="POST"
          action="/admin/courses/{{id}}/delete"
          onsubmit="return confirm('Are you sure you want to delete this course and all its sessions?');"
          class="mt-3"
        >
          <button type="submit" class="btn custom-btn-danger btn-sm w-100">
            Delete Course
          </button>
        </form>

      </article>
    </div>
    {{/courses}}

    {{^courses}}
    <div class="col-12">
      <div class="card section-card text-center p-4">
        <h3 class="mb-2">No courses found</h3>
        <p class="muted mb-0">
          Start by adding a new course.
        </p>
      </div>
    </div>
    {{/courses}}

  </div>

</main>

{{> footer}}