{{> head}}
{{> header}}

<main class="container py-4">

  <div class="row justify-content-center">
    <div class="col-12 col-md-6 col-lg-5">

      <!-- TITLE -->
      <section class="text-center mb-4">
        <h1 class="page-title mb-2">Login</h1>
        <p class="muted mb-0">
          Sign in to access your courses and bookings.
        </p>
      </section>

      <!-- ERROR -->
      {{#error}}
      <div class="message-error mb-3">
        {{error}}
      </div>
      {{/error}}

      <!-- FORM -->
      <section class="card section-card p-4">
        <form method="POST" action="/login" class="row g-3">

          <div class="col-12">
            <label for="email" class="form-label">Email</label>
            <input
              id="email"
              name="email"
              type="email"
              class="form-control"
              required
            />
          </div>

          <div class="col-12">
            <label for="password" class="form-label">Password</label>
            <input
              id="password"
              name="password"
              type="password"
              class="form-control"
              required
            />
          </div>

          <div class="col-12">
            <button type="submit" class="btn custom-btn-primary w-100">
              Login
            </button>
          </div>

        </form>

        <!-- REGISTER LINK -->
        <div class="text-center mt-3">
          <span class="muted">No account yet?</span>
          <a href="/register" class="ms-1">Register here</a>
        </div>
      </section>

    </div>
  </div>

</main>

{{> footer}}