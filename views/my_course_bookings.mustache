{{> head}}
{{> header}}

<main class="container py-4">

  <section class="mb-4">
    <h1 class="page-title mb-2">My Session Bookings</h1>
    <p class="muted mb-0">
      Course: <strong>{{course.title}}</strong>
    </p>
  </section>

  {{#successMessage}}
  <div class="message-success mb-4">
    <strong>{{successMessage}}</strong>
  </div>
  {{/successMessage}}

  <div class="mb-4">
    <a class="btn custom-btn-secondary" href="/my/courses">
      ← Back to My Courses
    </a>
  </div>

  <section class="card section-card p-3">
    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead>
          <tr>
            <th>Start</th>
            <th>End</th>
            <th>Status</th>
            <th>Created</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>

          {{#bookings}}
          <tr>
            <td>{{sessionStart}}</td>
            <td>{{sessionEnd}}</td>
            <td>{{status}}</td>
            <td>{{createdAt}}</td>
            <td>
              {{#canCancel}}
              <form
                method="POST"
                action="/my/bookings/{{id}}/cancel"
                onsubmit="return confirm('{{cancelMessage}}');"
              >
                <button type="submit" class="btn custom-btn-danger btn-sm">
                  Cancel
                </button>
              </form>
              {{/canCancel}}

              {{^canCancel}}
              <span class="muted">Cancelled</span>
              {{/canCancel}}
            </td>
          </tr>
          {{/bookings}}

          {{^bookings}}
          <tr>
            <td colspan="5" class="text-center muted">
              You have no session bookings for this course yet.
            </td>
          </tr>
          {{/bookings}}

        </tbody>
      </table>
    </div>
  </section>

</main>

{{> footer}}