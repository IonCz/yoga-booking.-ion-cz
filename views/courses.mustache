{{> head}}
{{> header}}

<main class="container py-4">

  <!-- PAGE TITLE -->
  <section class="mb-4">
    <h1 class="page-title mb-2">Courses</h1>
    <p class="muted mb-0">
      Browse current and upcoming yoga and mindfulness courses.
    </p>
  </section>

  <!-- FILTERS -->
  <section class="card p-3 mb-4">
    <h3 class="mb-3">Filter Courses</h3>

    <form method="GET" action="/courses" class="row g-3 align-items-end">
      <div class="col-12 col-md-4">
        <label class="form-label" for="level">Level</label>
        <select id="level" name="level" class="form-select">
          <option value="" {{^filters.level}}selected{{/filters.level}}>Any</option>
          <option value="beginner" {{#filters.level}}{{#levelBeginner}}selected{{/levelBeginner}}{{/filters.level}}>Beginner</option>
          <option value="intermediate" {{#filters.level}}{{#levelIntermediate}}selected{{/levelIntermediate}}{{/filters.level}}>Intermediate</option>
          <option value="advanced" {{#filters.level}}{{#levelAdvanced}}selected{{/levelAdvanced}}{{/filters.level}}>Advanced</option>
        </select>
      </div>

      <div class="col-12 col-md-5">
        <label class="form-label" for="q">Search</label>
        <input
          id="q"
          class="form-control"
          type="text"
          name="q"
          value="{{filters.q}}"
          placeholder="Title or description"
        />
      </div>

      <div class="col-12 col-md-3">
        <div class="d-flex gap-2 flex-wrap">
          <button type="submit" class="btn custom-btn-primary w-100">Apply</button>
          <a class="btn custom-btn-secondary w-100" href="/courses">Reset</a>
        </div>
      </div>
    </form>
  </section>

  <!-- COURSE CARDS -->
  <div class="row g-4">
    {{#courses}}
    <div class="col-12 col-md-6 col-xl-4">
      <article class="card h-100 border-0 section-card">
        <div class="card-body d-flex flex-column">
          <h2 class="h4 mb-3">{{title}}</h2>

          <p class="muted mb-3">
            <strong>Level:</strong> {{level}}
            <span class="mx-1">•</span>
            <strong>Type:</strong> {{type}}
            {{#allowDropIn}}
            <span class="mx-1">•</span>
            <span>Drop-in OK</span>
            {{/allowDropIn}}
          </p>

          <p class="mb-3">{{description}}</p>

          <div class="mb-3">
            <p class="muted mb-2">
              <strong>Dates:</strong> {{startDate}} – {{endDate}}
            </p>

            <p class="muted mb-2">
              <strong>Next session:</strong> {{nextSession}}
            </p>

            <p class="muted mb-0">
              <strong>Sessions:</strong> {{sessionsCount}}
            </p>
          </div>

          <div class="mt-auto">
            <a class="btn custom-btn-primary w-100" href="/courses/{{id}}">
              View &amp; Book
            </a>
          </div>
        </div>
      </article>
    </div>
    {{/courses}}

    {{^courses}}
    <div class="col-12">
      <div class="card section-card text-center p-4">
        <h2 class="h5 mb-2">No courses found</h2>
        <p class="muted mb-0">
          Try changing your filters or search term.
        </p>
      </div>
    </div>
    {{/courses}}
  </div>

  <!-- PAGINATION -->
  {{#pagination}}
  <div class="d-flex justify-content-center align-items-center gap-3 flex-wrap mt-4">
    {{#hasPrev}}
    <a class="btn custom-btn-secondary" href="{{prevLink}}">Previous</a>
    {{/hasPrev}}

    <span class="muted">
      Page {{page}} of {{totalPages}}
    </span>

    {{#hasNext}}
    <a class="btn custom-btn-secondary" href="{{nextLink}}">Next</a>
    {{/hasNext}}
  </div>
  {{/pagination}}
</main>

{{> footer}}
