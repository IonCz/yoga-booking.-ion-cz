{{> head}}
{{> header}}

<main class="container py-4">

  <!-- TITLE -->
  <section class="mb-4">
    <h1 class="page-title mb-2">Participant Session Activity</h1>
    <p class="muted mb-0">
      View session booking activity for a participant in this course.
    </p>
  </section>

  <!-- PARTICIPANT INFO -->
  <section class="card section-card p-4 mb-4">
    <div class="row g-3">
      <div class="col-12 col-md-4">
        <p class="mb-1"><strong>Course:</strong></p>
        <p class="muted mb-0">{{course.title}}</p>
      </div>

      <div class="col-12 col-md-4">
        <p class="mb-1"><strong>Name:</strong></p>
        <p class="muted mb-0">{{participant.name}}</p>
      </div>

      <div class="col-12 col-md-4">
        <p class="mb-1"><strong>Email:</strong></p>
        <p class="muted mb-0">{{participant.email}}</p>
      </div>
    </div>
  </section>

  <!-- BACK BUTTON -->
  <div class="mb-4">
    <a class="btn custom-btn-secondary" href="/admin/courses/{{course.id}}/participants">
      ← Back to Participants
    </a>
  </div>

  <!-- TABLE -->
  <section class="card section-card p-3">
    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead>
          <tr>
            <th>Session Start</th>
            <th>Session End</th>
            <th>Status</th>
            <th>Created</th>
          </tr>
        </thead>
        <tbody>

          {{#bookings}}
          <tr>
            <td>{{sessionStart}}</td>
            <td>{{sessionEnd}}</td>
            <td>
              <span class="muted">{{status}}</span>
            </td>
            <td>{{createdAt}}</td>
          </tr>
          {{/bookings}}

          {{^bookings}}
          <tr>
            <td colspan="4" class="text-center muted">
              No session activity found for this participant.
            </td>
          </tr>
          {{/bookings}}

        </tbody>
      </table>
    </div>
  </section>

</main>

{{> footer}}